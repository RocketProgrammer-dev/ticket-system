// Windows resource script. Compiled into the executable so Explorer, the
// taskbar and the window title bar all show the icon.
//
// IDI_ICON1 is a convention rather than a rule: Windows uses the icon with
// the LOWEST numeric id as the application icon, so this being first is what
// matters, not the name.

IDI_ICON1 ICON "appicon.ico"

// Version information. Shown on the file's Properties > Details tab, and
// used by installers to decide whether a file is newer. Worth filling in —
// an executable with blank version fields looks unfinished.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ticket System"
            VALUE "FileDescription",  "Ticket System Client"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TicketApp"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "TicketApp.exe"
            VALUE "ProductName",      "Ticket System"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
